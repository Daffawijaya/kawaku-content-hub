# Salin ke .env.local lalu isi dari Supabase Dashboard → Project Settings → API.
# JANGAN commit .env.local. Jangan pernah menaruh service-role key di sini.

NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google OAuth: Supabase Dashboard → Authentication → Providers → Google → enable,
# lalu tambahkan redirect URL: https://xyzcompany.supabase.co/auth/v1/callback
# dan Site URL + Redirect URLs aplikasi di Authentication → URL Configuration.

# Google Drive (SERVER ONLY — tanpa prefix NEXT_PUBLIC_, jangan ke browser).
# 1. Google Cloud Console → project → enable Google Drive API.
# 2. OAuth consent screen (External) + tambah email sendiri sebagai test user.
# 3. Credentials → Create OAuth client ID → tipe "Desktop app" → salin client ID/secret.
# 4. Buka https://developers.google.com/oauthplayground → Settings → "Use your own
#    OAuth credentials" → isi client ID/secret → pilih scope
#    https://www.googleapis.com/auth/drive.file → Authorize → Exchange code →
#    salin refresh token ke bawah.
# 5. Buat folder "KAWAKU Content Hub" di Google Drive → salin ID dari URL
#    (drive.google.com/drive/folders/FOLDER_ID).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Instagram Graph API via Facebook Login (SERVER ONLY).
# 1. Akun IG Business terhubung ke FB Page (selesaikan Page Publishing Authorization bila diminta).
# 2. developers.facebook.com → buat App → produk Instagram API (Facebook Login) →
#    permission: instagram_basic, instagram_content_publish, instagram_manage_contents,
#    pages_read_engagement, pages_show_list.
# 3. Graph API Explorer: GET /me/accounts?fields=instagram_business_account{id,username}
#    → salin IG user id + Page access token long-lived ke bawah.
IG_USER_ID=
IG_PAGE_ACCESS_TOKEN=
