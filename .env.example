# Salin ke .env.local lalu isi dari Supabase Dashboard → Project Settings → API.
# JANGAN commit .env.local. Jangan pernah menaruh service-role key di sini.

NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google OAuth: Supabase Dashboard → Authentication → Providers → Google → enable,
# lalu tambahkan redirect URL: https://xyzcompany.supabase.co/auth/v1/callback
# dan Site URL + Redirect URLs aplikasi di Authentication → URL Configuration.
